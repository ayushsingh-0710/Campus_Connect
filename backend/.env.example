# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8443
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_secret_value

# Database Configuration (supports both MONGO_URI and MONGODB_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect
MONGO_URI=mongodb://127.0.0.1:27017/campus_connect

# Brabble API Configuration (Primary Hackathon Provider)
HACKATHON_API_PROVIDER=brabble
HACKATHON_API_BASE_URL=https://brabble.ai
HACKATHON_API_KEY=PASTE_YOUR_BRABBLE_KEY_HERE
HACKATHON_SYNC_ENABLED=true

# API.SH Unstop API Configuration (Secondary Hackathon Provider)
APISH_API_KEY=PASTE_YOUR_APISH_KEY_HERE
APISH_BASE_URL=https://api.api.sh
